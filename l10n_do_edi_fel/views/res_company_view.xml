<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_company_form_inherit_l10n_my_myinvois" model="ir.ui.view">
        <field name="name">res.company.form.inherit.l10n_my_myinvois</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="inside">
                <group invisible="country_code != 'DO'">
                    <group string="E-Invoicing" colspan="2">
                        <group>
                            <field name="l10n_do_edi_username" />
                        </group>
                        <group>
                            <field name="l10n_do_edi_password" />
                        </group>
                    </group>
                    <group string="E-Invoicing EDI Enviroment" colspan="2">
                        <group>
                            <field name="l10n_do_edi_env" />
                        </group>
                        <group>
                            <field name="l10n_do_edi_production_env" />
                        </group>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
