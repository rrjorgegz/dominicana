<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.proxy.user</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='account_vendor_bills']" position="after">
                <block
          id='do_edi'
          title="Electronic Invoicing"
          invisible="country_code != 'DO'"
        >
                    <setting
            class="col-lg-12"
            string="Rep. Dominicana"
            company_dependent="1"
          >
                        <div class="content-group">
                            <div class="mt16 row">
                                <label
                  for="l10n_do_edi_username"
                  string="Username"
                  class="col-3 col-lg-3 o_light_label"
                />
                                <field name="l10n_do_edi_username" nolabel="1" />
                            </div>
                            <div class="row">
                                <label
                  for="l10n_do_edi_password"
                  string="Password"
                  class="col-3 col-lg-3 o_light_label"
                />
                                <field
                  name="l10n_do_edi_password"
                  password="True"
                  nolabel="1"
                />
                            </div>
                            <div class="row">
                                <label
                  for="l10n_do_edi_production_env"
                  string="EDI Environment"
                  class="col-3 col-lg-3 o_light_label"
                />
                                <field name="l10n_do_edi_production_env" />
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
